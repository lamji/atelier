{
  "name": "atelier",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first agentic AI software engineering platform",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.19 <21"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:parallel": "pnpm --parallel --filter @atelier/agent --filter @atelier/web dev",
    "dev:agent": "pnpm --filter @atelier/agent dev",
    "dev:web": "pnpm --filter @atelier/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "@tailwindcss/oxide"
    ]
  }
}
